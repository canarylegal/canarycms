# Example proprietary / white-label brand profile (Phase 2).
# Copy values into your real `.env` (or compose env) for a fork / OEM install.
# With this profile loaded, brand surfaces must not leak Canary Legal Software
# names or URLs (see backend/tests/test_brand_config.py).
#
# Product display name is env-only (not Admin). Support inbox can still be
# overridden in Admin → Firm details.

CANARY_BRAND_PRODUCT_NAME=Example Firm Platform
CANARY_BRAND_VENDOR_URL=https://platform.example
CANARY_BRAND_SUPPORT_INBOX=support@platform.example
CANARY_BRAND_TOTP_ISSUER=Example Firm Platform
CANARY_BRAND_WEBAUTHN_RP_NAME=Example Firm Platform
CANARY_BRAND_TB_UPDATE_BASE_URL=https://platform.example/thunderbird

# Point update checks at the fork's GitHub (not canarylegal/canarycms).
CANARY_GITHUB_DEPLOY_OWNER=example-org
CANARY_GITHUB_DEPLOY_REPO=example-firm-platform
CANARY_GITHUB_DEPLOY_REF=latest-release
