    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "heartbeat"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "installation_id": {
          "type": "string",
          "format": "uuid"
        },
        "stream_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        },
        "last_observation_sequence": {
          "type": "integer",
          "minimum": 1
        }
