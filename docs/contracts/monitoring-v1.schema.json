            "application": {
              "enum": [
                "up",
                "down",
                "unknown",
                "disabled",
                "not_configured"
              ]
            },
            "database": {
              "enum": [
                "up",
                "down",
                "unknown",
                "disabled",
                "not_configured"
              ]
            },
            "storage": {
              "enum": [
                "up",
                "down",
                "unknown",
                "disabled",
                "not_configured"
              ]
            },
            "onlyoffice": {
              "enum": [
                "up",
                "down",
                "unknown",
                "disabled",
                "not_configured"
              ]
            },
            "public_access": {
              "enum": [
                "up",
                "down",
                "unknown",
                "disabled",
                "not_configured"
              ]
            },
            "backup": {
              "enum": [
                "up",
                "down",
                "unknown",
                "disabled",
                "not_configured"
              ]
            },
            "recovery": {
              "enum": [
                "up",
                "down",
                "unknown",
                "disabled",
                "not_configured"
              ]
            },
            "monitor_source": {
              "enum": [
                "up",
                "down",
                "unknown",
                "disabled",
                "not_configured"
              ]
            }
          },
          "required": [
            "application",
            "database",
            "storage",
            "onlyoffice",
            "public_access",
            "backup",
            "recovery",
            "monitor_source"
