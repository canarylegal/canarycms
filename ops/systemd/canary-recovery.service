[Unit]
Description=Canary recovery job
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Replace with the SAME Docker operator account used for deployment.
User=canary
EnvironmentFile=/etc/canary/operations.env
UMask=0077
ExecStart=/usr/bin/python3 ${CANARY_SOURCE}/scripts/operations.py --config ${CANARY_OPERATIONS_CONFIG} recovery-check
TimeoutStartSec=45min
KillMode=mixed
TimeoutStopSec=5min
