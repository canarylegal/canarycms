# Local backup archives (see scripts/backup-canary.sh)
backups/

.env
MASTER_ADMIN_CREDENTIALS.txt

# Compiled Python
__pycache__/
*.pyc

# Case/user data files
data/

# Compose GUI runtime state (job JSON + compose-up markers; not user uploads)
.canary/runtime/
# Legacy compose GUI artifacts (pre-.canary/runtime)
.canary-compose-job-state.json
.canary-compose-up-*.json

# Firm-specific scripts/configs must not land in public canarycms.
# Prefer a private firm package (docs/FIRM_PACKAGE.md); these patterns catch strays.
backend/scripts/seed_*_portal_forms.py
backend/scripts/run_*_precedents_deploy.sh
backend/scripts/deploy_*_precedents.py
backend/scripts/prepare_*_precedents.py
backend/scripts/prepare_*_quote_precedent.py
backend/scripts/prepare_*_quote_spreadsheet.py
backend/scripts/seed_*_fee_scales.py
deploy/*/policies.json

# Stray artifacts
backend/=2.8.0
claudecanary1.txt

# Portable Node.js toolchain (used when system npm is unavailable)
.tools/

# Thunderbird add-on build artifacts

# Isolated workflow test evidence
/artifacts/

# Generated from pinned canary-outlook hosting bundle
frontend/public/outlook-addin/
frontend/public/.well-known/microsoft-officeaddins-allowed.json
